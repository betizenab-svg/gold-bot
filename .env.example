TWELVEDATA_API_KEY=your_twelvedata_api_key_here_for_fallback
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here_for_future_sprints

# Direct-first, proxy-on-failure fallback controls
PROXY_FALLBACK_ENABLED=1
PROXY_FALLBACK_MAX_PROXIES=8
PROXY_REQUEST_TIMEOUT_SECONDS=15
PROXYSCRAPE_ENDPOINT=https://api.proxyscrape.com/v4/free-proxy-list/get?request=display_proxies&protocol=http&proxy_format=ipport&format=text&timeout=6000
