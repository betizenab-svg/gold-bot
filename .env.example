TWELVEDATA_API_KEY=your_twelvedata_api_key_here_for_fallback
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
UAT_MODE=False
UAT_TELEGRAM_CHAT_ID=

# --- Signal quality & risk (v2) ---
# Strategy timeframe. M5 recommended (M1 is too noisy for delayed feeds).
SIGNAL_TIMEFRAME=M5
# Stop-loss geometry
ATR_SL_MULTIPLIER=1.5
SL_MIN_USD=3.0
SL_MIN_ATR_MULT=1.0
# Pending signals expire after this many minutes without triggering
SIGNAL_EXPIRY_MINUTES=90
# ACTIVE trades that never reach TP1 are closed flat after this many hours
ACTIVE_MAX_HOLD_HOURS=24
# Attach a rendered candlestick chart (entry/SL/TP marked) to each signal
CHART_ALERTS_ENABLED=1

# --- Risk governor ---
RISK_MAX_SIGNALS_PER_DAY=6
RISK_SL_COOLDOWN_MINUTES=45
RISK_CONSECUTIVE_SL_HALT=3
RISK_HALT_HOURS=6
RISK_TIER2_CONSECUTIVE_SL=5
RISK_DAILY_MAX_LOSS_R=3.0
RISK_DAILY_PROFIT_LOCK_R=4.0
NEWS_BLACKOUT_BEFORE_MIN=30
NEWS_BLACKOUT_AFTER_MIN=15
# Automatic news calendar sync and weekly Telegram performance report
NEWS_AUTOFETCH_ENABLED=1
WEEKLY_REPORT_ENABLED=1

# Direct-first, proxy-on-failure fallback controls
PROXY_FALLBACK_ENABLED=1
PROXY_FALLBACK_MAX_PROXIES=8
PROXY_REQUEST_TIMEOUT_SECONDS=15
PROXYSCRAPE_ENDPOINT=https://api.proxyscrape.com/v4/free-proxy-list/get?request=display_proxies&protocol=http&proxy_format=ipport&format=text&timeout=6000
